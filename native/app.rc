#include <windows.h>
#include <commctrl.h>
1 RT_MANIFEST TASKMGR_MANIFEST
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,2,0,0
PRODUCTVERSION 1,2,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Task Manager"
   VALUE "FileVersion", "1.2.0.0"
   VALUE "ProductName", "Task Manager"
   VALUE "ProductVersion", "1.2.0.0"
   VALUE "OriginalFilename", "TaskManager.exe"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
101 DIALOGEX 0, 0, 280, 104
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Create new task"
FONT 9, "Segoe UI"
BEGIN
 ICON "", 1004, 8, 10, 21, 20
 LTEXT "Type the name of a program, folder, document, or Internet resource, and Windows will open it for you.", -1, 36, 10, 236, 20
 LTEXT "&Open:", -1, 8, 40, 26, 10
 EDITTEXT 1001, 36, 38, 236, 13, ES_AUTOHSCROLL
 AUTOCHECKBOX "Create this task with administrative privileges.", 1003, 36, 58, 236, 12
 DEFPUSHBUTTON "OK", IDOK, 112, 82, 50, 14, WS_DISABLED
 PUSHBUTTON "Cancel", IDCANCEL, 167, 82, 50, 14
 PUSHBUTTON "&Browse...", 1002, 222, 82, 50, 14
END
102 DIALOGEX 0, 0, 200, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Processor affinity"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "", 1002, 8, 8, 184, 18
 CONTROL "", 1001, "SysListView32", LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 8, 30, 184, 140
 DEFPUSHBUTTON "OK", IDOK, 88, 178, 50, 14
 PUSHBUTTON "Cancel", IDCANCEL, 142, 178, 50, 14
END
103 DIALOGEX 0, 0, 430, 270
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Task Manager"
FONT 9, "Segoe UI"
BEGIN
 EDITTEXT 1001, 10, 10, 410, 225, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL
 DEFPUSHBUTTON "Close", IDOK, 360, 246, 60, 14
END

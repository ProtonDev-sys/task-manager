#include <windows.h>
1 RT_MANIFEST "../app.manifest"
101 DIALOGEX 0, 0, 300, 100
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Run new task"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Enter a program or command:", -1, 12, 10, 276, 12
 EDITTEXT 1001, 12, 28, 230, 14, ES_AUTOHSCROLL
 PUSHBUTTON "Browse...", 1002, 248, 28, 42, 14
 AUTOCHECKBOX "Create this task with administrative privileges", 1003, 12, 52, 276, 12
 DEFPUSHBUTTON "OK", IDOK, 184, 76, 50, 14
 PUSHBUTTON "Cancel", IDCANCEL, 240, 76, 50, 14
END
102 DIALOGEX 0, 0, 300, 85
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Processor affinity"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Hexadecimal mask (one processor group, maximum 64 CPUs):", -1, 12, 10, 276, 20
 EDITTEXT 1001, 12, 32, 276, 14, ES_AUTOHSCROLL
 DEFPUSHBUTTON "OK", IDOK, 184, 60, 50, 14
 PUSHBUTTON "Cancel", IDCANCEL, 240, 60, 50, 14
END
103 DIALOGEX 0, 0, 430, 270
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Wait chain analysis"
FONT 9, "Segoe UI"
BEGIN
 EDITTEXT 1001, 10, 10, 410, 225, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL
 DEFPUSHBUTTON "Close", IDOK, 360, 246, 60, 14
END
